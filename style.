body{

margin:0;
font-family:Arial;
background:#111;
color:white;

}

.container{

display:flex;
height:100vh;

}

.editor{

width:35%;
background:#ffffff;
color:black;
padding:20px;

}

.editor input,
.editor textarea{

width:100%;
padding:8px;
margin-bottom:10px;

}

.preview{

width:65%;
display:flex;
justify-content:center;
align-items:center;

}

.phone{

width:360px;
height:720px;
background:#000;
border-radius:25px;
padding:15px;
overflow:auto;

}

.header{

text-align:center;
font-size:18px;
margin-bottom:10px;

}

.profile{

display:flex;
align-items:center;
gap:20px;

}

.profilePic{

width:80px;
height:80px;
border-radius:50%;

}

.stats{

display:flex;
gap:25px;
text-align:center;

}

.stats span{

font-weight:bold;
font-size:18px;

}

.bio{

margin-top:10px;
font-size:14px;

}

.dashboard{

background:#222;
padding:10px;
border-radius:10px;
margin-top:10px;

}

.buttons{

display:flex;
gap:10px;
margin-top:10px;

}

.buttons button{

flex:1;
padding:8px;
background:#333;
border:none;
color:white;
border-radius:8px;

}

.tabs{

display:flex;
justify-content:space-around;
margin-top:10px;

}

.grid{

margin-top:10px;
display:grid;
grid-template-columns:repeat(3,1fr);
gap:2px;

}

.post{

background:#333;
height:110px;

}

@media(max-width:800px){

.container{

flex-direction:column;

}

.editor{

width:100%;

}

.preview{

width:100%;

}

}
